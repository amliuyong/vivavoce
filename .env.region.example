# VivaVoce region-specific deployment configuration.
#
# Copy this file to .env.region, fill in local values, then run:
#   chmod 600 .env.region
#
# Never commit .env.region. Do not put AWS access keys in this file.

AWS_PROFILE=
AWS_REGION=us-east-1

# Fail closed if the active AWS profile points at another account.
VIVA_EXPECT_ACCOUNT=

# HTTPS entry point. All three values are required for deployment.
VIVA_CUSTOM_DOMAIN=viva.example.com
VIVA_ROUTE53_ZONE_ID=
VIVA_ROUTE53_ZONE_NAME=example.com

# Optional external identity provider. Leave all five empty to let the stack
# create its own Cognito resources; otherwise set all five.
VIVA_AUTH_REGION=
VIVA_AUTH_USER_POOL_ID=
VIVA_AUTH_USER_POOL_CLIENT_ID=
VIVA_AUTH_MCP_CLIENT_ID=
VIVA_AUTH_HOSTED_UI_DOMAIN=

# GPU and container settings.
VIVA_GPU_INSTANCE_TYPE=g6e.xlarge
VIVA_GPU_IMAGE_TAG=
VIVA_GPU_SESSIONS_PER_INSTANCE=
VIVA_CONTAINER_ARCH=amd64

# Optional regional package mirrors.
VIVA_PIP_INDEX_URL=
VIVA_NPM_REGISTRY=

# Optional runtime calibration overrides. Leave empty unless the deployment
# has intentionally calibrated values that must survive every rollout.
VIVA_CURSOR_VOICED_GATE=
VIVA_BARGE_OPEN_COOLDOWN_MS=
VIVA_BARGE_OPEN_COOLDOWN_MULT=

# Remote deployment orchestration. These values are read only by the local
# deploy command and are copied from the existing remote configuration into
# each exact-commit release directory.
VIVA_REMOTE_HOST=
VIVA_REMOTE_BASE_DIR=
VIVA_REMOTE_ACTIVE_LINK=
VIVA_REMOTE_CONFIG_DIR=
VIVA_REMOTE_E2E_WAV=
VIVA_REMOTE_REQUIRE_CI=1
VIVA_REMOTE_DEPLOY_TIMEOUT_SECONDS=3600
VIVA_REMOTE_DRAIN_TIMEOUT_SECONDS=600
