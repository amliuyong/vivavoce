# VivaVoce common configuration.
#
# Copy this file to .env, fill in local values, then run:
#   chmod 600 .env
#
# Never commit .env. Prefer an AWS profile or SSO session over long-lived
# AWS access keys.

VIVA_STACK_NAME=Voce
VIVA_ADMIN_EMAIL=
VIVA_ENGINE_TYPE=three_stage

# Deployment controls. Keep disabled unless intentionally running unattended.
VIVA_AUTO_APPROVE=0
VIVA_SKIP_TESTS=0

# Optional provider credentials. The deployment must seed these into an
# appropriate secret store; application logs must never print them.
VIVA_BEDROCK_API_KEY=
VIVA_MINIMAX_API_KEY=

# Optional server-side key used only by remote post-deployment audio checks.
VIVA_E2E_KEY=

# Optional model bootstrap URL. Treat a presigned URL as a credential.
VIVA_MODEL_WEIGHTS_URL=
VIVA_MODEL_WEIGHTS_DIR=
VIVA_WORK_DIR=
