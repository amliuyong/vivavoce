{
  "name": "vivavoce-infrastructure",
  "version": "0.1.0",
  "description": "AWS CDK infrastructure for VivaVoce",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy",
    "test": "jest",
    "lint": "eslint lib bin",
    "lint:fix": "eslint lib bin --fix"
  },
  "dependencies": {
    "aws-cdk-lib": "2.266.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "aws-cdk": "2.1138.0",
    "cdk-nag": "^2.35.0",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.61.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js"
    ]
  }
}
